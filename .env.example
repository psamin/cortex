# Cortex configuration. Copy to .env (gitignored) and fill in what you have.
# Anything left blank falls back to a disclosed local equivalent; the studio
# header and GET /api/health show which provider is active.

# --- InsForge: Postgres metadata, private storage bucket, Model Gateway (VLM + agent)
# Dashboard -> Settings -> Connect. Use the admin key (ik_...), never the anon key.
INSFORGE_BASE_URL=
INSFORGE_API_KEY=
INSFORGE_BUCKET=cortex-assets
# Files above the REST upload cap (ACT checkpoints, ~200 MB) go through InsForge's S3 gateway.
# Create project S3 access keys in Dashboard -> Storage -> Settings -> S3 Configuration (secret shown once).
# Endpoint and region are read from the project (GET /api/storage/s3/config); set them only to override.
INSFORGE_REST_MAX_MB=50
INSFORGE_S3_ACCESS_KEY_ID=
INSFORGE_S3_SECRET_ACCESS_KEY=
INSFORGE_S3_ENDPOINT=
INSFORGE_S3_REGION=
# Self-hosted InsForge only (InsForge Cloud provisions this through its Model Gateway):
OPENROUTER_API_KEY=
VLM_MODEL=anthropic/claude-sonnet-5.5
AGENT_MODEL=anthropic/claude-sonnet-5.5

# --- Our own planner model (default when set): an OpenAI-compatible endpoint, e.g. vLLM serving
# Qwen3-VL on Futurama. `scripts/vlm_futurama.sh up` submits the job, opens the tunnel and fills these in.
PLANNER_BASE_URL=
PLANNER_API_KEY=
SELFHOSTED_MODEL=Qwen/Qwen3-VL-8B-Instruct

# --- Training on GT Futurama (needs the GT VPN; uses your ~/.ssh/config alias)
FUTURAMA_SSH_HOST=futurama
FUTURAMA_PARTITION=general
FUTURAMA_GRES=gpu:l40s:1

# --- MCP
# Shared secret between a hosted (Manufact) MCP server and this backend when tunneled:
#   openssl rand -hex 24
CORTEX_MCP_KEY=
# Optional operator token that lets an MCP client approve training (otherwise approve in the studio):
CORTEX_APPROVAL_SECRET=

# --- Local servers
PUBLIC_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
